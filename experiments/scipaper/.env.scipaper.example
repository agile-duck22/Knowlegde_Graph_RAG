# Isolated Environment Configuration Template for Scientific-Paper RAG Experiment
# Copy this file to .env.scipaper and replace placeholder values.
#
# MANDATORY ISOLATION RULES:
# 1. Never point to production ports (5432, 7687) or production database (kgr_db).
# 2. Never enable paid embeddings (ALLOW_PAID_EMBEDDINGS must remain false).
# 3. Use local sentence_transformers with all-MiniLM-L6-v2 (384 dimensions).

ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Domain
DOMAIN=scientific_papers

# Embedding Configuration (ZERO-COST LOCAL ONLY)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
ALLOW_PAID_EMBEDDINGS=false
OPENAI_API_KEY=

# LLM Provider Configuration (Optional for retrieval/preflight, needed for synthesis in Phase D)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Isolated Neo4j Graph Database (Host Port 7688, HTTP 7475)
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=scipaper_neo4j_password_change_me

# Isolated PostgreSQL Relational & Vector Database (Host Port 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=scipaper_db
POSTGRES_USER=scipaper_user
POSTGRES_PASSWORD=scipaper_pg_password_change_me

# Ingestion & Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EXTRACTION_BATCH_SIZE=10
EXTRACTION_MAX_RETRIES=3

# Retrieval & Routing Settings
ROUTER_CONFIDENCE_THRESHOLD=0.65
VECTOR_TOP_K=5
HYBRID_VECTOR_TOP_K=3
VECTOR_SIMILARITY_THRESHOLD=0.60
GRAPH_MAX_HOPS=2
GRAPH_NODE_LIMIT=25
MAX_CONTEXT_TOKENS=6000
