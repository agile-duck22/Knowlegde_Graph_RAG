# Environment Configuration Template
# Copy this file to .env and replace placeholder values

ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider Configuration
# Supported providers: groq, gemini, openrouter, anthropic
LLM_PROVIDER=gemini
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Per-Component Provider Overrides (defaults to LLM_PROVIDER if unset):
EXTRACTION_PROVIDER=gemini
ROUTING_PROVIDER=groq
SYNTHESIS_PROVIDER=gemini

# Per-Component Model Selection:
# Extraction: gemini-3.1-flash-lite (or gemini-3.5-flash-lite, gemini-2.5-flash, gemini-1.5-flash)
# Routing: openai/gpt-oss-20b (or llama-3.1-8b-instant)
# Synthesis: gemini-3.1-flash-lite (or gemini-3.5-flash-lite, gemini-2.5-flash, gemini-1.5-flash)
# OpenRouter Fallback/Reference: nvidia/nemotron-3.5-lightning:free, meta-llama/llama-3.3-70b-instruct:free (must end in :free)
EXTRACTION_MODEL=gemini-3.1-flash-lite
ROUTING_MODEL=openai/gpt-oss-20b
SYNTHESIS_MODEL=gemini-3.1-flash-lite
LLM_MODEL=gemini-3.1-flash-lite

# Embedding Configuration (Zero-Cost Local vs Paid OpenAI)
# For zero-cost local embeddings (recommended):
#   EMBEDDING_PROVIDER=sentence_transformers
#   EMBEDDING_MODEL=all-MiniLM-L6-v2
#   EMBEDDING_DIMENSIONS=384
# For paid OpenAI embeddings (requires ALLOW_PAID_EMBEDDINGS=true and OPENAI_API_KEY):
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=your_openai_api_key_here
ALLOW_PAID_EMBEDDINGS=false

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# PostgreSQL Database with pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kgr_db
POSTGRES_USER=kgr_user
POSTGRES_PASSWORD=kgr_password

# Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EXTRACTION_BATCH_SIZE=10
EXTRACTION_MAX_RETRIES=3

# Retrieval & Routing Settings
ROUTER_CONFIDENCE_THRESHOLD=0.65
VECTOR_TOP_K=5
HYBRID_VECTOR_TOP_K=3
VECTOR_SIMILARITY_THRESHOLD=0.60
GRAPH_MAX_HOPS=2
GRAPH_NODE_LIMIT=25
MAX_CONTEXT_TOKENS=6000
